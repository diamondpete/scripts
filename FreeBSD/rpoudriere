#!/bin/sh
# Update every poudriere ports tree, reapply the local patches kept at its root,
# then bulk build the port list against each tree.
set -u

###
### Settings
###
PATH_PORTLIST="/usr/local/etc/poudriere.d/port-list"
PATH_PORTS="/usr/local/poudriere/ports"
TREES="HEAD overlay"
OVERLAY="overlay"
LOCKFILE="/var/run/rpoudriere.lock"

BIN_POUDRIERE="/usr/local/bin/poudriere"
BIN_PATCH="/usr/bin/patch"
BIN_GIT="/usr/local/bin/git"
BIN_LOCKF="/usr/bin/lockf"

#####################################################################
### Don't change stuff below here unless you know what you're doing #
#####################################################################

SCRIPTNAME=${0##*/}

log() {
	echo "[$SCRIPTNAME] $*"
}

die() {
	echo "$SCRIPTNAME: $*" >&2
	exit 1
}

#
# Don't run this script more than once at a time.  lockf holds the lock for as
# long as the re-executed script runs and drops it however that script dies,
# neither of which a ps(1) scan can do.
#
if [ "${RPOUDRIERE_LOCKED-}" != yes ]; then
	RPOUDRIERE_LOCKED=yes
	export RPOUDRIERE_LOCKED
	"$BIN_LOCKF" -t 0 "$LOCKFILE" "$0" "$@"
	status=$?
	[ ${status} -eq 75 ] && die "already running"
	exit ${status}
fi

###
### Parameters
###
[ $# -eq 1 ] || die "usage: ${SCRIPTNAME} <jail>"
JAIL=$1

#
# Reset a tree to its upstream branch, discarding the patches the last run
# applied.  The cd runs in a subshell: /usr/bin/cd exits 0 without changing this
# script's directory, so git would otherwise run wherever the caller stood.
#
clean_tree() {
	log "Cleaning ports tree... $1"
	(cd "${PATH_PORTS}/$1" && $BIN_GIT fetch origin && $BIN_GIT reset --hard origin/main) ||
		die "could not reset $1"
}

#
# Apply every patch kept at the root of a tree.  patch(1) resolves the paths in
# a diff against its working directory, so it runs inside the tree.
#
patch_tree() {
	log "Patching ports tree... $1"
	for diff in "${PATH_PORTS}/$1"/patch*; do
		[ -f "${diff}" ] || continue
		(cd "${PATH_PORTS}/$1" && $BIN_PATCH --posix -EfN < "${diff}") ||
			log "  FAILED: ${diff##*/}"
	done
}

#
# Update every tree, then reapply its patches.
#
trees_update() {
	for tree in ${TREES}; do
		[ -d "${PATH_PORTS}/${tree}" ] || die "no such ports tree: ${tree}"

		log "Updating ports tree... ${tree}"
		clean_tree "${tree}"
		$BIN_POUDRIERE ports -p "${tree}" -u || die "could not update ${tree}"
		patch_tree "${tree}"
	done
}

#
# Build the port list against every tree except the overlay, which is mounted
# into each of those builds with -O instead of being built on its own.
#
poudriere_build() {
	status=0

	for tree in ${TREES}; do
		[ "${tree}" = "${OVERLAY}" ] && continue

		log "Building... ${tree}"
		$BIN_POUDRIERE bulk -j "${JAIL}" -p "${tree}" -O "${OVERLAY}" \
			-f "${PATH_PORTLIST}" || status=1
	done

	return ${status}
}

#
# Script main stuff
#
log "trees: ${TREES}"
trees_update
poudriere_build
