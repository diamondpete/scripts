#!/bin/sh

# Back up the database, prune old backups, update the JAR, prune old JARs,
# then restart komga once everything is in place.

. /usr/local/etc/komga.conf

: "${KOMGA_APP_DIR:=/opt/komga}"
: "${KOMGA_USER:=komga}"

# If any step fails, an error message will be printed and you will have to exit, ignore SC2015.
# shellcheck disable=SC2015
komga-backup && komga-clean-backup && komga-update --no-restart && komga-clean-jar \
|| { echo "❌ Komga update failed." >&2 ; exit 1; }
chown -R "$KOMGA_USER" "$KOMGA_APP_DIR"

sudo systemctl restart komga

echo "✅ komga update is complete!"
echo "App dir: $KOMGA_APP_DIR"
echo "Komga version: $(jq -r '.name // "unknown"' "$KOMGA_APP_DIR/release-latest.json" 2>/dev/null || echo unknown)"
