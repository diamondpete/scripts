#!/bin/sh

usage()
{
	cat <<EOS >&2
Usage: $(basename "$0") [OPTIONS]
  DESCRIPTION
    Clean Komga backup database files.
    This command depends on a few variables in /usr/local/etc/komga.conf.
  OPTIONS
    -t|--target target_dir     Target directory to clean
                               Default: /opt/komga/backup
    -p|--prefix prefix         Backup file prefix
                               Default: komga_database_
    -s|--suffix suffix         Backup file suffix
                               Default: .sqlite
    -k|--keep keep_file_count  Number of generations to keep.
                               Default: 3
    --dry-run                  List the files that would be deleted without deleting them.
    -h|--help                  Show usage
    --debug                    Execute with debug mode
  EXAMPLE
    * Run the clean with the default parameters.
      That is, it will delete all files matching 'komga_database_*.sqlite' in '/opt/komga/backup' except the latest three generations.
      $ $(basename "$0")

    * If you want to see the files to be removed without removing them, try the '--dry-run' option.
      $ $(basename "$0") --dry-run
EOS
}

# Exit with an error if option $1 has no value $2
need_arg()
{
	if [ -z "$2" ]; then
		echo "❌ Option '$1' requires an argument" >&2
		usage
		exit 1
	fi
}

parse_args()
{
	while [ $# -gt 0 ];
	do
		case $1 in
			--debug)
				set -x
			;;

			--dry-run)
				DRY_RUN=true
			;;

			--target|-t)
				need_arg "$1" "$2"
				KOMGA_BACKUP_DEST_DIR=$2
				shift
			;;

			--prefix|-p)
				need_arg "$1" "$2"
				KOMGA_BACKUP_PREFIX=$2
				shift
			;;

			--suffix|-s)
				need_arg "$1" "$2"
				KOMGA_BACKUP_SUFFIX=$2
				shift
			;;

			--keep|-k)
				need_arg "$1" "$2"
				KOMGA_BACKUP_KEEP_SIZE=$2
				shift
			;;

			--help|-h)
				usage
				exit 0
			;;

			*)
				echo "❌ Invalid option '$1'" >&2
				usage
				exit 1
			;;
		esac
		shift
	done
}

init_params()
{
	: "${KOMGA_BACKUP_DEST_DIR:=/opt/komga/backup}"
	: "${KOMGA_BACKUP_PREFIX:=komga_database_}"
	: "${KOMGA_BACKUP_SUFFIX:=.sqlite}"
	: "${KOMGA_BACKUP_KEEP_SIZE:=3}"
}

validate_params()
{
	if [ ! -d "$KOMGA_BACKUP_DEST_DIR" ]; then
		echo "❌ Destination dir '$KOMGA_BACKUP_DEST_DIR' does not exist or is not a directory." >&2
		exit 1
	fi

	case $KOMGA_BACKUP_KEEP_SIZE in
		''|*[!0-9]*)
			echo "❌ Keep count '$KOMGA_BACKUP_KEEP_SIZE' is not a number." >&2
			exit 1
		;;
	esac
}

main()
{
	# Backup names embed a sortable timestamp, so newest sorts first in reverse order
	find "$KOMGA_BACKUP_DEST_DIR" -maxdepth 1 -type f -name "${KOMGA_BACKUP_PREFIX}*${KOMGA_BACKUP_SUFFIX}" \
		| sort -r | tail -n +"$((KOMGA_BACKUP_KEEP_SIZE + 1))" \
		| while IFS= read -r file; do
			if $DRY_RUN; then
				echo "Would delete: $file"
			else
				rm -f "$file"
			fi
		done
}

DRY_RUN=false
. /usr/local/etc/komga.conf
parse_args "$@"
init_params
validate_params
main
