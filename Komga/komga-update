#!/bin/sh

usage()
{
	cat <<EOS >&2
Usage: $(basename "$0") [OPTIONS]
  DESCRIPTION
    Update the komga JAR file to the latest version.
    This command will not delete the old JAR file.
    If you want to remove it, use 'komga-clean-jar'.
    This command depends on a few variables in /usr/local/etc/komga.conf.
  OPTIONS
    --no-restart  Do not restart the komga service after updating
    -h|--help     Show usage
    --debug       Execute with debug mode
  EXAMPLE
    * When executed, it will retrieve the latest JAR file based on the GitHub release information.
      At the same time, update the link for 'komga-latest.jar' and restart komga if the version changed.
      $ $(basename "$0")
EOS
}

parse_args()
{
	while [ $# -gt 0 ];
	do
		case $1 in
			--debug)
				set -x
			;;

			--no-restart)
				RESTART=false
			;;

			--help|-h)
				usage
				exit 0
			;;

			*)
				echo "❌ Invalid option '$1'" >&2
				usage
				exit 1
			;;
		esac
		shift
	done
}

init_params()
{
	: "${KOMGA_APP_DIR:=/opt/komga}"
}

validate_params()
{
	if [ ! -d "$KOMGA_APP_DIR" ]; then
		echo "❌ Destination dir '$KOMGA_APP_DIR' does not exist or is not a directory." >&2
		exit 1
	fi
}

# Print field $1 (name or browser_download_url) of the JAR asset in release file $2
jar_asset()
{
	jq -r --arg field "$1" '[.assets[] | select(.name | test("komga.*\\.jar$"))][0][$field] // empty' "$2"
}

main()
{
	cd "$KOMGA_APP_DIR" || { echo "❌ Komga app dir not found." >&2 ; exit 1; }

	# Fetch release info to a temp file so a failed fetch leaves release-latest.json intact
	wget -qO "release-latest.json.tmp" https://api.github.com/repos/gotson/komga/releases/latest \
		|| { rm -f "release-latest.json.tmp"; echo "❌ Komga release info fetch failed." >&2 ; exit 1; }

	jar=$(jar_asset name "release-latest.json.tmp")
	url=$(jar_asset browser_download_url "release-latest.json.tmp")
	if [ -z "$jar" ] || [ -z "$url" ]; then
		rm -f "release-latest.json.tmp"
		echo "❌ No Komga JAR found in the latest release." >&2
		exit 1
	fi

	if [ -f "$jar" ]; then
		echo "✅ Komga is already at the latest version ($jar)."
		rm -f "release-latest.json.tmp"
		updated=false
	else
		# Download to a partial file so an interrupted download is never mistaken for a JAR
		wget -qO "$jar.part" "$url" && mv -f "$jar.part" "$jar" \
			|| { rm -f "$jar.part" "release-latest.json.tmp"; echo "❌ Komga jar fetch failed." >&2 ; exit 1; }

		if [ -f "release-latest.json" ]; then
			mv -f "release-latest.json" "release-previous.json"
		fi
		mv -f "release-latest.json.tmp" "release-latest.json"

		chown komga "$jar"
		echo "✅ Downloaded Komga $jar"
		updated=true
	fi

	# Refresh the link even when up to date in case it points at a removed JAR
	ln -sf "$jar" "komga-latest.jar"

	if $updated && $RESTART; then
		echo "Restarting komga"
		sudo systemctl restart komga
	fi
}

RESTART=true
. /usr/local/etc/komga.conf
parse_args "$@"
init_params
validate_params
main
