#!/bin/sh

usage()
{
	cat <<EOS >&2
Usage: $(basename "$0") [OPTIONS]
  DESCRIPTION
    Update plex to a new version.
    Without -v, the latest public release is installed. If the installed version is
    newer than the latest public release (i.e. a beta), the latest beta is used instead.
    Never downgrades unless a version is given with -v.
  OPTIONS
    -v|--version <VERSION>      Install a specific version (allows downgrades)
    -b|--beta                   Use the latest Plex Pass beta
    -d|--data-dir <DIR>         Plex data directory (holds 'Library/Application Support')
                                Default: \$PLEX_DATA_DIR, or /var/lib/plexmediaserver
    -f|--force                  Reinstall even if the version is already installed
    -h|--help                   Show usage
  BETA
    Betas need the server's Plex Pass account token. It is read from the server's
    Preferences.xml in the data directory (via sudo), or from the PLEX_TOKEN
    environment variable if set.
    If the account has no Plex Pass, Plex returns the public release instead.
  EXAMPLE
    * Update to the latest version on the current channel (public or beta).
      $ $(basename "$0")
    * Switch to the latest Plex Pass beta.
      $ $(basename "$0") -b
    * Update to Version 1.32.8.7639-fb6452ebf.
      $ $(basename "$0") -v 1.32.8.7639-fb6452ebf
EOS
}

parse_args()
{
	while [ $# -gt 0 ];
	do
		case $1 in
			--version|-v)
				if [ -z "$2" ]; then
					echo "❌ Option '$1' requires a version argument" >&2
					usage
					exit 1
				fi
				APP_VERSION=$2
				shift
			;;

			--beta|-b)
				BETA=true
			;;

			--data-dir|-d)
				if [ -z "$2" ]; then
					echo "❌ Option '$1' requires a directory argument" >&2
					usage
					exit 1
				fi
				PLEX_DATA_DIR=$2
				shift
			;;

			--force|-f)
				FORCE=true
			;;

			--help|-h)
				usage
				exit 0
			;;

			*)
				echo "❌ Invalid option '$1'" >&2
				usage
				exit 1
			;;
		esac
		shift
	done
}

DOWNLOADS_API=https://plex.tv/api/downloads/5.json
# Print the Plex account token: $PLEX_TOKEN, or the one the server signed in with
plex_token()
{
	if [ -n "$PLEX_TOKEN" ]; then
		echo "$PLEX_TOKEN"
		return
	fi
	preferences="$PLEX_DATA_DIR/Library/Application Support/Plex Media Server/Preferences.xml"
	sudo sed -n 's/.*PlexOnlineToken="\([^"]*\)".*/\1/p' "$preferences" 2>/dev/null | head -n 1
}

# Print the latest public (non Plex Pass) Linux release version
latest_public()
{
	wget -qO- "$DOWNLOADS_API" | jq -r '.computer.Linux.version // empty'
}

# Print the latest Plex Pass (beta) Linux release version, using token $1.
# The token goes in a header rather than the URL.
latest_beta()
{
	wget -qO- --header="X-Plex-Token: $1" "$DOWNLOADS_API?channel=plexpass" | jq -r '.computer.Linux.version // empty'
}

main()
{
	installed=$(dpkg-query -W -f='${Version}' plexmediaserver 2>/dev/null)

	if [ -z "$APP_VERSION" ]; then
		explicit=false
		APP_VERSION=$(latest_public)
		[ -n "$APP_VERSION" ] || { echo "❌ Plex release info fetch failed." >&2; exit 1; }
		channel=public

		# Stay on the beta channel when a beta newer than the latest public release is installed
		if $BETA || { [ -n "$installed" ] && dpkg --compare-versions "$installed" gt "$APP_VERSION"; }; then
			token=$(plex_token)
			if [ -n "$token" ]; then
				beta=$(latest_beta "$token")
				[ -n "$beta" ] || { echo "❌ Plex beta release info fetch failed." >&2; exit 1; }
				APP_VERSION=$beta
				channel=beta
			elif $BETA; then
				echo "❌ No Plex token found. Sign the server in to Plex, or set PLEX_TOKEN." >&2
				exit 1
			fi
		fi
	else
		explicit=true
	fi

	if [ "$installed" = "$APP_VERSION" ] && ! $FORCE; then
		echo "✅ Plex $APP_VERSION is already installed (use -f to reinstall)."
		return
	fi

	if ! $explicit && [ -n "$installed" ] && dpkg --compare-versions "$installed" gt "$APP_VERSION"; then
		echo "✅ Plex $installed is newer than the latest $channel release ($APP_VERSION); not downgrading."
		echo "   Use -v <VERSION> to install a specific version."
		return
	fi

	echo "Updating Plex ${installed:-(not installed)} -> $APP_VERSION"

	fileName="plexmediaserver_${APP_VERSION}_amd64.deb"
	tmpDir=$(mktemp -d) || exit 1
	trap 'rm -rf "$tmpDir"' EXIT
	FILE=$tmpDir/$fileName

	wget -qO "$FILE" "https://downloads.plex.tv/plex-media-server-new/${APP_VERSION}/debian/$fileName" \
		|| { echo "❌ Download of $fileName failed. Is '$APP_VERSION' a valid version?" >&2; exit 1; }

	# The package restarts plexmediaserver itself
	sudo dpkg -i "$FILE" || { echo "❌ Installation of $fileName failed." >&2; exit 1; }

	echo "✅ Plex $APP_VERSION installed."
}

: "${PLEX_DATA_DIR:=/var/lib/plexmediaserver}"
BETA=false
FORCE=false
APP_VERSION=
parse_args "$@"
main
