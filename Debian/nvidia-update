#!/bin/sh

# Directory holding the MOK signing key pair (Nvidia.key / Nvidia.der).
# See "Creating and Importing Keys" in install_driver() for how to generate it.
KEYSTORE="<path-to-keystore>"

BASE_URL="https://download.nvidia.com/XFree86/Linux-x86_64"

usage()
{
	cat <<EOS >&2
Usage: $(basename "$0") [OPTIONS]
  DESCRIPTION
    Update or reinstall nvidia drivers.
    By default the newest driver on download.nvidia.com is used, which is often
    newer than the production branch release listed in latest.txt.
  OPTIONS
    -r|--reinstall              Reinstall current driver after kernel update
    -v|--version <VERSION>      Install a specific version (skips the installed version check)
    -p|--production             Use the production branch release from latest.txt
    -h|--help                   Show usage
  EXAMPLE
    * Reinstall current driver if newer version not available
      $ $(basename "$0") -r
    * Install a specific driver version
      $ $(basename "$0") -v 580.95.05
EOS
}

parse_args()
{
	while [ $# -gt 0 ]; do
		case $1 in
			--reinstall|-r)
				REINSTALL=true
			;;
			--production|-p)
				PRODUCTION=true
			;;
			--help|-h)
				usage
				exit 0
			;;
			--version|-v)
				if [ -z "$2" ]; then
					echo "❌ Option '$1' requires a version argument" >&2
					usage
					exit 1
				fi
				TARGET_VERSION=$2
				shift
			;;
			*)
				echo "❌ Invalid option '$1'" >&2
				usage
				exit 1
			;;
		esac
		shift
	done

	if [ -n "$TARGET_VERSION" ] && ! echo "$TARGET_VERSION" | grep -Eq '^[0-9]+(\.[0-9]+)+$'; then
		echo "❌ Invalid version '$TARGET_VERSION'" >&2
		exit 1
	fi
}

# True if $1 <= $2 (version comparison)
verlte() {
	printf '%s\n' "$1" "$2" | sort -C -V
}

# True if $1 < $2 (version comparison)
verlt() {
	! verlte "$2" "$1"
}

# Print the installed driver version, or nothing if nvidia-smi is missing or
# cannot talk to the driver (e.g. module not built for the running kernel).
local_version() {
	command -v nvidia-smi >/dev/null 2>&1 || return 0
	nvidia-smi --version 2>/dev/null | awk 'NR==1 && $4 ~ /^[0-9]+(\.[0-9]+)+$/ {print $4}'
}

run_file() {
	echo "NVIDIA-Linux-x86_64-$1.run"
}

# Print the production branch version NVIDIA lists in latest.txt
production_version() {
	wget -qO- "$BASE_URL/latest.txt" | awk 'NR==1{print $1}'
}

# Print the newest version folder on the download site that has an installer.
# A folder can appear before its .run is uploaded, so check the newest few.
newest_version() {
	wget -qO- "$BASE_URL/" \
		| grep -oE "href=['\"][0-9]+(\.[0-9]+)+/['\"]" | grep -oE '[0-9]+(\.[0-9]+)+' \
		| sort -Vru | head -n 5 \
		| while read -r version; do
			if wget -q --spider "$BASE_URL/$version/$(run_file "$version")"; then
				echo "$version"
				break
			fi
		done
}

# Print the version to update to
remote_version() {
	if $PRODUCTION; then
		production_version
	else
		newest_version
	fi
}

# Check installer $2 for driver version $1 against NVIDIA's published SHA-256.
# A bad file is deleted so the next run downloads it again. Older drivers
# (e.g. 390.x) have no checksum file, so verification is skipped for them.
verify_driver() {
	expected=$(wget -qO- "$BASE_URL/$1/$2.sha256sum" | awk 'NR==1{print $1}')
	if [ -z "$expected" ]; then
		echo "⚠️  No checksum available for $2, skipping verification"
		return
	fi

	actual=$(sha256sum "$2" | awk '{print $1}')
	if [ "$actual" != "$expected" ]; then
		echo "❌ Checksum mismatch for $2, deleted it. Run again to re-download." >&2
		rm -f "$2"
		exit 1
	fi
	echo "✅ Checksum verified for $2"
}

# Download (if not already present), verify and install driver version $1
install_driver() {
	file=$(run_file "$1")

	if [ ! -f "$file" ]; then
		echo "Downloading $file"
		wget -q "$BASE_URL/$1/$file" || { echo "❌ Download of $file failed." >&2; rm -f "$file"; exit 1; }
	fi

	# Also verifies a previously kept installer before a reinstall
	verify_driver "$1" "$file"

	# ==Creating and Importing Keys==
	# openssl req -new -x509 -newkey rsa:2048 -keyout <path-to-keystore>/Nvidia.key -outform DER -out <path-to-keystore>/Nvidia.der -nodes -days 36500 -subj "/CN=Graphics Drivers"
	# sudo mokutil --import <path-to-keystore>/Nvidia.der
	# echo options nouveau modeset=0 | sudo tee -a /etc/modprobe.d/nouveau-kms.conf; sudo update-initramfs -u
	# ==Blacklist NovaCore==
	# sudo tee /etc/modprobe.d/blacklist-nova.conf <<'EOF'
	# blacklist nova_core
	# blacklist nova-core
	# blacklist nova_drm
	# EOF
	# ==Blacklist NovaCore/nouveau in kernel==
	# sudo tee /etc/modprobe.d/nova-blacklist.conf <<'EOF'
	# blacklist nova_core
	# install nova_core /bin/true
	# install nova_drm /bin/true
	# blacklist nouveau
	# install nouveau /bin/true
	# options nouveau modeset=0
	# EOF
	# sudo update-initramfs -u
	sudo sh "./$file" --dkms \
		--module-signing-secret-key="$KEYSTORE/Nvidia.key" \
		--module-signing-public-key="$KEYSTORE/Nvidia.der" \
		|| { echo "❌ Installation of $1 failed." >&2; exit 1; }
}

# Remove the installer for the previous driver ($1) once $2 is installed.
# The installer for the current driver is kept for kernel changes requiring a reinstall.
remove_previous() {
	if [ -n "$1" ] && [ "$1" != "$2" ]; then
		rm -f "$(run_file "$1")"
	fi
}

main() {
	LOCAL_VERSION=$(local_version)

	# Explicit version requested: install it without comparing against the
	# installed driver (nvidia-smi may not work, e.g. after a kernel update)
	if [ -n "$TARGET_VERSION" ]; then
		echo "Installing NVIDIA Drivers $TARGET_VERSION"
		install_driver "$TARGET_VERSION"
		remove_previous "$LOCAL_VERSION" "$TARGET_VERSION"
		return
	fi

	REMOTE_VERSION=$(remote_version)
	[ -n "$REMOTE_VERSION" ] || { echo "❌ NVIDIA release info fetch failed." >&2; exit 1; }

	if [ -z "$LOCAL_VERSION" ]; then
		echo "⚠️  Unable to detect installed driver, installing $REMOTE_VERSION"
		install_driver "$REMOTE_VERSION"
	elif verlt "$LOCAL_VERSION" "$REMOTE_VERSION"; then
		echo "Updating NVIDIA Drivers $LOCAL_VERSION -> $REMOTE_VERSION"
		install_driver "$REMOTE_VERSION"
		remove_previous "$LOCAL_VERSION" "$REMOTE_VERSION"
	else
		echo "Drivers Up-to-Date ($LOCAL_VERSION)"
		if $REINSTALL; then
			# Installed driver may be newer than latest.txt (e.g. installed with -v)
			echo "Reinstalling NVIDIA Drivers $LOCAL_VERSION"
			install_driver "$LOCAL_VERSION"
		fi
	fi
}

REINSTALL=false
PRODUCTION=false
TARGET_VERSION=
parse_args "$@"
main
nvidia-smi
