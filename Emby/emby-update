#!/bin/sh

usage()
{
	cat <<EOS >&2
Usage: $(basename "$0") [OPTIONS]
  DESCRIPTION
    Update emby to a new version.
    Without -v, the latest stable release on GitHub is installed. If the installed
    version is newer than the latest stable (i.e. a beta), the latest beta is used instead.
    Never downgrades unless a version is given with -v.
  OPTIONS
    -v|--version <VERSION>      Install a specific version (allows downgrades)
    -b|--beta                   Use the latest release including betas
    -f|--force                  Reinstall even if the version is already installed
    -h|--help                   Show usage
  EXAMPLE
    * Update to the latest version on the current channel (stable or beta).
      $ $(basename "$0")
    * Switch to the latest beta.
      $ $(basename "$0") -b
    * Update to version '4.8.0.62'.
      $ $(basename "$0") -v 4.8.0.62
EOS
}

parse_args()
{
	while [ $# -gt 0 ];
	do
		case $1 in
			--version|-v)
				if [ -z "$2" ]; then
					echo "❌ Option '$1' requires a version argument" >&2
					usage
					exit 1
				fi
				EMBY_VERSION=$2
				shift
			;;

			--beta|-b)
				BETA=true
			;;

			--force|-f)
				FORCE=true
			;;

			--help|-h)
				usage
				exit 0
			;;

			*)
				echo "❌ Invalid option '$1'" >&2
				usage
				exit 1
			;;
		esac
		shift
	done
}

RELEASES_API=https://api.github.com/repos/MediaBrowser/Emby.Releases/releases

# Print the tag of the latest stable (non-prerelease) Emby release
latest_stable()
{
	wget -qO- "$RELEASES_API/latest" \
		| sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -n 1
}

# Print the highest tag among recent releases, betas included
latest_beta()
{
	wget -qO- "$RELEASES_API?per_page=30" \
		| sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | sort -V | tail -n 1
}

# True if version $1 is newer than version $2
newer()
{
	dpkg --compare-versions "$1" gt "$2"
}

main()
{
	installed=$(dpkg-query -W -f='${Version}' emby-server 2>/dev/null)

	if [ -z "$EMBY_VERSION" ]; then
		explicit=false
		stable=$(latest_stable)
		[ -n "$stable" ] || { echo "❌ Emby release info fetch failed." >&2; exit 1; }

		# Stay on the beta channel when a beta newer than the latest stable is installed
		if $BETA || { [ -n "$installed" ] && newer "$installed" "$stable"; }; then
			EMBY_VERSION=$(latest_beta)
			[ -n "$EMBY_VERSION" ] || { echo "❌ Emby release info fetch failed." >&2; exit 1; }
			channel=beta
		else
			EMBY_VERSION=$stable
			channel=stable
		fi
	else
		explicit=true
	fi

	if [ "$installed" = "$EMBY_VERSION" ] && ! $FORCE; then
		echo "✅ Emby $EMBY_VERSION is already installed (use -f to reinstall)."
		return
	fi

	if ! $explicit && [ -n "$installed" ] && newer "$installed" "$EMBY_VERSION"; then
		echo "✅ Emby $installed is newer than the latest $channel release ($EMBY_VERSION); not downgrading."
		echo "   Use -v <VERSION> to install a specific version."
		return
	fi

	echo "Updating Emby ${installed:-(not installed)} -> $EMBY_VERSION"

	fileName="emby-server-deb_${EMBY_VERSION}_amd64.deb"
	tmpDir=$(mktemp -d) || exit 1
	trap 'rm -rf "$tmpDir"' EXIT
	FILE=$tmpDir/$fileName

	wget -qO "$FILE" "https://github.com/MediaBrowser/Emby.Releases/releases/download/${EMBY_VERSION}/$fileName" \
		|| { echo "❌ Download of $fileName failed. Is '$EMBY_VERSION' a valid version?" >&2; exit 1; }

	sudo dpkg -i "$FILE" || { echo "❌ Installation of $fileName failed." >&2; exit 1; }

	# dpkg replaced the service file, so re-apply the run-as user (this restarts emby-server)
	sudo update-emby-owner

	echo "✅ Emby $EMBY_VERSION installed."
}

BETA=false
FORCE=false
EMBY_VERSION=
parse_args "$@"
main
