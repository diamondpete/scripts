[Unit]
Description=Sonarr Daemon
Wants=network-online.target
After=network-online.target

[Service]
User=sonarr
Group=sonarr
Type=simple

ExecStart=/opt/Sonarr/Sonarr -nobrowser -data=/usr/local/sonarr
TimeoutStopSec=20
# Upstream recommendation: Sonarr's updater runs as a child process and must
# survive the service being stopped during an update
KillMode=process
Restart=on-failure

[Install]
WantedBy=multi-user.target
